{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rn-sandbox",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rn-sandbox.a2f0.net", "custom_domain": true }],
  "assets": {
    "directory": "./web/build",
    // The app has one page and no client-side routes, so a missing path gets
    // web/public/404.html with a 404 status rather than the app with a 200.
    "not_found_handling": "404-page"
  }
}
