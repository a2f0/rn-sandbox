{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rn-sandbox",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rn-sandbox.a2f0.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
