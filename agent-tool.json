{
  "schemaVersion": 1,
  "merge": {
    "requiredChecks": [
      { "name": "code-quality (20)", "workflow": "Github Actions" },
      { "name": "detox-android (20)", "workflow": "Github Actions" },
      { "name": "detox-macos (20, 3.3)", "workflow": "Github Actions" }
    ]
  },
  "versions": { "lockfile": null },
  "pr": { "rejectClaudeBranding": true },
  "permissions": {
    "executables": {
      "detox": "exec",
      "playwright": "intake",
      "wrangler": "release"
    }
  },
  "branch": {
    "types": null,
    "exempt": ["main"],
    "maxLength": null
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "images": {
    "targets": {
      "ios": {
        "dir": "ios/sandbox/Images.xcassets",
        "outputs": [
          {
            "path": "AppIcon.appiconset/AppIcon.png",
            "size": 1024,
            "opaque": true,
            "layers": [
              { "source": "background", "fit": "cover" },
              { "source": "logo" }
            ]
          }
        ]
      },
      "android": {
        "dir": "android/app/src/main/res",
        "outputs": [
          {
            "path": "mipmap-{variant}/ic_launcher_background.png",
            "size": 108,
            "variants": "android",
            "opaque": true,
            "layers": [{ "source": "background", "fit": "cover" }]
          },
          {
            "path": "mipmap-{variant}/ic_launcher_foreground.png",
            "size": 108,
            "variants": "android",
            "layers": [{ "source": "logo", "size": 72 }]
          },
          {
            "path": "mipmap-{variant}/ic_launcher_monochrome.png",
            "size": 108,
            "variants": "android",
            "layers": [{ "source": "logo", "size": 72, "tint": "#ffffff" }]
          },
          {
            "path": "mipmap-{variant}/ic_launcher.png",
            "size": 48,
            "variants": "android",
            "opaque": true,
            "layers": [
              { "source": "background", "fit": "cover" },
              { "source": "logo" }
            ]
          },
          {
            "path": "mipmap-{variant}/ic_launcher_round.png",
            "size": 48,
            "variants": "android",
            "mask": "circle",
            "layers": [
              { "source": "background", "fit": "cover" },
              { "source": "logo" }
            ]
          }
        ]
      },
      "favicons": {
        "outputs": [
          {
            "path": "favicon.svg",
            "size": 1024,
            "mask": { "cornerRadius": 0.21875 },
            "layers": [
              { "source": "background", "fit": "cover" },
              { "source": "logo", "scale": 1.2 }
            ]
          },
          {
            "path": "favicon.ico",
            "sizes": [16, 32, 48],
            "mask": { "cornerRadius": 0.21875 },
            "layers": [
              { "source": "background", "fit": "cover" },
              { "source": "logo", "scale": 1.2 }
            ]
          },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [
              { "source": "background", "fit": "cover" },
              { "source": "logo" }
            ]
          },
          {
            "path": "og-image.png",
            "size": [1200, 630],
            "opaque": true,
            "layers": [
              { "source": "background", "fit": "cover" },
              { "source": "logo" }
            ]
          }
        ]
      }
    }
  }
}
