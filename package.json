{
  "name": "sandbox",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "android": "sh scripts/ensureGradleWrapper.sh && react-native run-android",
    "ios": "react-native run-ios",
    "web": "npm run -s build:wasm && vite",
    "build:wasm": "sh scripts/buildWasm.sh",
    "build:web": "npm run -s build:wasm && vite build",
    "preview:web": "vite preview",
    "deploy:web": "npm run build:web && wrangler deploy",
    "lint": "biome check .",
    "lint:md": "markdownlint --dot \"**/*.md\" --ignore-path .gitignore --ignore .git --ignore vendor",
    "lint:shell": "shellcheck -x scripts/*.sh scripts/*/*.sh",
    "start": "react-native start",
    "test": "npm run -s build:wasm && jest",
    "test:web": "playwright test",
    "prepare": "husky && sh scripts/ensureGradleWrapper.sh --optional",
    "agent-tool": "agent-tool",
    "agents:sync": "agent-tool skills install --apply",
    "agents:check": "agent-tool skills check"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.4",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.1.2",
    "detox": "20.51.4",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "allowScripts": {
    "detox@20.51.4": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "dtrace-provider": false,
    "esbuild": false,
    "workerd": false
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "5.4.2"
    }
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.sandbox.specs"
    },
    "ios": {
      "modulesProvider": {
        "NativeRoundTrip": "RCTNativeRoundTrip",
        "NativeRoundTripCxx": "NativeRoundTripCxxProvider"
      }
    }
  }
}
