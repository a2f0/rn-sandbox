{
  "name": "sandbox",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "biome check .",
    "lint:md": "markdownlint --dot \"**/*.md\" --ignore-path .gitignore --ignore .git --ignore vendor",
    "lint:shell": "shellcheck scripts/*.sh",
    "start": "react-native start",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.87.1",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "detox": "20.51.4",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "allowScripts": {
    "detox@20.51.4": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "dtrace-provider": false
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "5.4.2"
    }
  }
