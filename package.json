{
  "name": "sandbox",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "android": "sh scripts/ensureGradleWrapper.sh && react-native run-android",
    "ios": "react-native run-ios",
    "web": "npm run -s build:wasm && vite",
    "build:wasm": "sh scripts/buildWasm.sh",
    "build:web": "npm run -s build:wasm && vite build",
    "preview:web": "vite preview",
    "preview:deploy:web": "npm run build:web && wrangler deploy --dry-run",
    "deploy:web": "npm run build:web && wrangler deploy",
    "auth:provision": "node scripts/auth/provision.mjs",
    "lint": "biome check .",
    "lint:md": "npm run -s test:markdownlint && markdownlint --dot \"**/*.md\" --ignore-path .gitignore --ignore .git --ignore vendor --ignore .agents/skills/update-dependencies --ignore .claude/skills/update-dependencies",
    "lint:shell": "shellcheck -x scripts/*.sh scripts/*/*.sh",
    "start": "react-native start",
    "test": "npm run -s build:wasm && jest && node --test scripts/auth/*.test.mjs",
    "test:web": "playwright test",
    "prepare": "husky && sh scripts/ensureGradleWrapper.sh --optional",
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agents:sync": "agent-tool skills install --apply",
    "agents:check": "agent-tool skills check",
    "test:markdownlint": "node --test scripts/checks/markdownlintConfig.test.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.16.3",
    "@firebase/auth": "1.13.7",
    "@invertase/react-native-apple-authentication": "2.5.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.14",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.10",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "detox": "20.51.4",
    "fake-indexeddb": "6.2.6",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.10",
    "test-renderer": "1.3.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": "^24.12.0 || >=26.0.0"
  },
  "allowScripts": {
    "detox@20.51.4": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "dtrace-provider": false,
    "esbuild": false,
    "workerd": false,
    "@firebase/util": false
  },
  "overrides": {
    "markdownlint-cli@0.49.1": {
      "js-yaml": "5.5.0",
      "smol-toml": "1.9.1"
    },
    "miniflare@5.20261006.0-alpha": {
      "sharp": "0.35.5"
    }
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.sandbox.specs"
    },
    "ios": {
      "modulesProvider": {
        "NativeRoundTrip": "RCTNativeRoundTrip",
        "NativeRoundTripCxx": "NativeRoundTripCxxProvider"
      }
    }
  }
}
